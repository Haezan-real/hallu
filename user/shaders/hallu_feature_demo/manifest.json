{
  "name": "Hallu Feature Demo",
  "language": "glsl",
  "surfaces": {
    "background": {
      "storage": 16,
      "passes": [
        {
          "name": "life",
          "type": "compute",
          "file": "life.comp",
          "channels": [
            { "source": "life", "filter": "nearest" },
            { "source": "noise.png", "filter": "nearest" }
          ]
        },
        {
          "name": "trail",
          "file": "trail.frag",
          "channels": [{ "source": "life", "filter": "nearest" }, "trail"]
        },
        {
          "file": "image.frag",
          "channels": ["trail", { "source": "noise.png", "wrap": "repeat" }]
        }
      ]
    }
  }
}
