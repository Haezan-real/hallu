// Game of Life as a compute pass: one invocation per cell, reading last frame's cells
// from iChannel0 (this pass itself) and seeding from the noise texture in iChannel1.
// Hold the mouse to paint live cells.
const int CELL = 4;
const int STEP_EVERY = 6;

// Live-cell count, double-buffered by frame so the screen pass reads a finished total
HALLU_STORAGE Stats { uint population[2]; };

layout(local_size_x = 8, local_size_y = 8) in;

float hash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void main() {
  ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
  ivec2 grid = ivec2(iResolution.xy) / CELL;
  if (cell.x >= grid.x || cell.y >= grid.y) return;

  uint slot = uint(iFrame) & 1u;
  if (cell == ivec2(0)) population[1u - slot] = 0u;

  float alive = texelFetch(iChannel0, cell, 0).r;
  if (iFrame == 0) {
    alive = step(0.8, texelFetch(iChannel1, cell % 256, 0).r);
  } else if (iFrame % STEP_EVERY == 0) {
    int neighbours = 0;
    for (int y = -1; y <= 1; y++) {
      for (int x = -1; x <= 1; x++) {
        if (x == 0 && y == 0) continue;
        ivec2 other = (cell + ivec2(x, y) + grid) % grid;
        neighbours += int(texelFetch(iChannel0, other, 0).r > 0.5);
      }
    }
    alive = (neighbours == 3 || (alive > 0.5 && neighbours == 2)) ? 1.0 : 0.0;
    // Rare spontaneous births keep the board from dying out
    if (hash(vec2(cell) + iTime) < 0.0004) alive = 1.0;
  }
  if (iMouse.z > 0.0 && distance(vec2(cell * CELL), iMouse.xy) < 40.0) alive = 1.0;

  if (alive > 0.5) atomicAdd(population[slot], 1u);
  imageStore(iOutput, cell, vec4(alive, 0.0, 0.0, 1.0));
}
