{
  "name": "cyberpunk",
  "language": "glsl",
  "constants": {
    "REFLECTION_REACH": 10
  },
  "surfaces": {
    "background": {
      "storage": 512,
      "passes": [
        { "name": "traffic", "type": "compute", "file": "traffic.comp", "dispatch": [1, 1, 1] },
        {
          "name": "rain",
          "type": "geometry",
          "vertex": "rain.vert",
          "file": "rain.frag",
          "vertexCount": 6,
          "instanceCount": 9000,
          "blend": "add"
        },
        { "name": "scene", "file": "drive.frag", "channels": [{ "source": "rain", "filter": "nearest" }] },
        { "name": "blurHalf", "file": "blurDown.frag", "scale": 0.5, "channels": ["scene"] },
        { "name": "blurQuarter", "file": "blurDown.frag", "scale": 0.25, "channels": ["blurHalf"] },
        { "name": "blurEighth", "file": "blurDown.frag", "scale": 0.125, "channels": ["blurQuarter"] },
        { "name": "blurQuarterUp", "file": "blurUp.frag", "scale": 0.25, "channels": ["blurEighth"] },
        { "name": "blurHalfUp", "file": "blurUp.frag", "scale": 0.5, "channels": ["blurQuarterUp"] },
        { "name": "dash", "file": "dash.frag", "channels": ["blurHalfUp"] },
        { "file": "glass.frag", "channels": ["scene", "blurHalf", "blurHalfUp", { "source": "dash", "filter": "nearest" }] }
      ]
    }
  }
}
